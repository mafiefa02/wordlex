{
  "name": "@wordlex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@wordlex/domain": "workspace:*",
    "arktype": "^2.2.3",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
