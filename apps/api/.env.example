PORT=4000
# Only `development` or `test` turns off the Game token's Secure flag, which
# plain http locally needs. Anything else — including unset — keeps it on.
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Locally these are the same container on 5432 — docker-compose.yml runs plain
# Postgres, with no Supavisor in front of it. In production they differ: the app
# goes through the pooler in transaction mode on 6543, migrations and seeding
# stay on 5432. `prepare: false` is on in both so dev behaves like prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Signs the per-Track Game token (ADR 0022). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Deliberately blank: the server refuses to boot without a real one.
COOKIE_SECRET=
