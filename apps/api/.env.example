PORT=4000
# `info` unless told otherwise. Turn it up to `debug` without a code change.
# LOG_LEVEL=info
# Only `development` or `test` turns off the Game token's Secure flag, which
# plain http locally needs. Anything else — including unset — keeps it on.
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Locally these are the same container on 5432 — docker-compose.yml runs plain
# Postgres, with no Supavisor in front of it. In production they differ: the app
# goes through the pooler in transaction mode on 6543, migrations and seeding
# stay on 5432. `prepare: false` is on in both so dev behaves like prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Signs the per-Track Game token (ADR 0022). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Deliberately blank: the server refuses to boot without a real one.
COOKIE_SECRET=

# Signs better-auth's session cookie, and is deliberately not COOKIE_SECRET:
# rotating one should not invalidate the other. Generate it the same way.
BETTER_AUTH_SECRET=

# This API's own base URL. Google redirects back to `<this>/api/auth/callback/google`,
# and that exact string has to be an Authorized redirect URI on the OAuth client.
BETTER_AUTH_URL=http://localhost:4000

# An OAuth 2.0 Client ID of type "Web application", from the Google Cloud
# console under APIs & Services → Credentials (ADR 0025).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The domain the session cookie is set on, so one sign-in covers all three
# subdomains (ADR 0006) — `wordlex.afiefabd.com` in production, where a
# leading dot would be a no-op. Leave it unset locally:
# every app is on `localhost`, where a domain-scoped cookie is not accepted.
# AUTH_COOKIE_DOMAIN=
