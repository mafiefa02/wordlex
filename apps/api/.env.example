PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Locally these are the same container on 5432 — docker-compose.yml runs plain
# Postgres, with no Supavisor in front of it. In production they differ: the app
# goes through the pooler in transaction mode on 6543, migrations and seeding
# stay on 5432. `prepare: false` is on in both so dev behaves like prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres
