NEXT_PUBLIC_PLAY_URL=http://localhost:3001

# This app's own origin. Every canonical, social card, sitemap URL and the
# `Sitemap:` line in robots.txt is built on it, so a production build with this
# unset throws rather than baking `localhost` into what a crawler reads.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The domain the theme cookie is set on, so a choice made here carries to the
# play app (ADR 0006 puts them on separate origins, and localStorage does not
# cross one). `wordlex.afiefabd.com` in production: the landing page's own host,
# which play and the API sit under. A leading dot is a no-op, and anything more
# specific than the host setting the cookie is rejected outright — the toggle
# would still work and the choice would vanish on reload. Leave it unset
# locally: every app is on `localhost`, where a domain cookie is not accepted.
# NEXT_PUBLIC_COOKIE_DOMAIN=wordlex.afiefabd.com
