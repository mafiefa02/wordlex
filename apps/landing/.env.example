NEXT_PUBLIC_PLAY_URL=http://localhost:3001

# The API's origin. Sign-in is a browser fetch straight to it, so this has to be
# the real origin and that origin has to be in the API's ALLOWED_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Only used for metadataBase, so social cards resolve absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
