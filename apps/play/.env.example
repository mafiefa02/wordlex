# The API's origin. Every call the board makes is a browser fetch straight to
# it, so this has to be the real origin and that origin has to be in the API's
# ALLOWED_ORIGINS. `https://api.wordlex.afiefabd.com` in production.
VITE_API_URL=http://localhost:4000

# The landing page's origin. Only the lockup in the header links to it, so a
# wrong value is a bad link rather than a broken game — which is why this one
# falls back instead of failing the build.
VITE_SITE_URL=http://localhost:3000
