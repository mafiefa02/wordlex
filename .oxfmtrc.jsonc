{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/*.md",
    ".claude/**",
    ".agents/**",
    "**/dist/**",
    "**/.next/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/.tanstack/**",
    "**/.turbo/**",
    "apps/play/src/routeTree.gen.ts",
    "apps/landing/next-env.d.ts",
    ".intent/**",
  ],
  "sortTailwindcss": {
    // If this path ever stops resolving, oxfmt exits 0 and quietly stops sorting.
    // Move the stylesheet and this line moves with it.
    "stylesheet": "./packages/ui/src/styles/globals.css",
    "functions": ["cn", "clsx", "cva", "twMerge"],
  },
  "sortPackageJson": false,
}
